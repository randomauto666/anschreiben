[Unit]
Description=Anschreiben-Generator (anschreiben.nexttick.eu)
After=network-online.target

[Service]
User=nobody
Group=nogroup
WorkingDirectory=/opt/anschreiben
EnvironmentFile=/etc/anschreiben.env
ExecStart=/usr/bin/python3 /opt/anschreiben/server.py
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
